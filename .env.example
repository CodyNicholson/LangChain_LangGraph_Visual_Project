# Copy to .env (git-ignored) and fill in. Every value is optional: without an API key
# the lab runs all demos on an offline scripted model.

# Claude for "Live" mode (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# The site is public through the tunnel: cap what visitors can spend in live mode
ALLOW_LIVE_MODE=true
LIVE_RUNS_PER_MINUTE=6
LIVE_RUNS_PER_HOUR=120

# Optional LangSmith tracing of every run
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain-langgraph-visual-lab

# Optional: only used by pipeline-run.sh when TUNNEL_TOKEN is not set globally on the server
TUNNEL_TOKEN=
